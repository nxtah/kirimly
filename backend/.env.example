# ── Server ──
PORT=3001
NODE_ENV=development
# Comma-separated allowed frontend origins. Empty = allow all (OK for local dev only)
CORS_ORIGIN=
# Set to "true" when running behind Nginx so rate limiting sees the real client IP
TRUST_PROXY=

# ── Database ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kirimly
DB_USER=postgres
DB_PASSWORD=postgres

# ── Authentication ──
JWT_SECRET=change_this_to_random_64_char_string
JWT_EXPIRES_IN=24h

# ── Blast ──
BLAST_DELAY_MIN_MS=5000
BLAST_DELAY_MAX_MS=10000
BLAST_WAVE_DELAY_MIN_MS=900000
BLAST_WAVE_DELAY_MAX_MS=1200000
BLAST_MAX_WAVES=3
BLAST_MAX_PER_WAVE=20

# ── CMAB (Contextual Multi-Armed Bandit) ──
CMAB_ALPHA=0.3
CMAB_REWARD_DELAY_HOURS=2

# ── First admin account (used by `npm run db:setup`) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
